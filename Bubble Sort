arr = [64, 34, 25, 12, 22, 11, 90]
print(arr)
n= len(arr)
print(n)

def bubblesort(arr):
  for i in range(n):
    swapped = False
    for j in range(0, n-i-1):
      if arr[j] > arr[j+1]:
        arr[j], arr[j+1] = arr[j+1], arr[j]
        swapped = True
    if (swapped == False):
      break



if __name__ == "__main__":
  arr = [64, 34, 25, 12, 22, 11, 90]
  bubblesort(arr)
  print(arr)
  print("Sorted array:")

  for i in range(len(arr)):
    print("%d" % arr[i], end=" ")
